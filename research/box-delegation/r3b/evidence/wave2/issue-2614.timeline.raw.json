4T21:33:58Z","updated_at":"2026-10-06T20:11:57Z","pushed_at":"2026-10-05T03:28:29Z","git_url":"git://github.com/tj/commander.js.git","ssh_url":"git@github.com:tj/commander.js.git","clone_url":"https://github.com/tj/commander.js.git","svn_url":"https://github.com/tj/commander.js","homepage":"","size":4034,"stargazers_count":28416,"watchers_count":28416,"language":"JavaScript","has_issues":true,"has_projects":true,"has_downloads":false,"has_wiki":true,"has_pages":true,"has_discussions":false,"forks_count":1783,"mirror_url":null,"archived":false,"disabled":false,"open_issues_count":12,"license":{"key":"mit","name":"MIT License","spdx_id":"MIT","url":"https://api.github.com/licenses/mit","node_id":"MDc6TGljZW5zZTEz"},"allow_forking":true,"is_template":false,"web_commit_signoff_required":false,"has_pull_requests":true,"pull_request_creation_policy":"all","topics":[],"visibility":"public","forks":1783,"open_issues":12,"watchers":28416,"default_branch":"master","permissions":{"admin":false,"maintain":false,"push":false,"triage":false,"pull":true}},"pull_request":{"url":"https://api.github.com/repos/tj/commander.js/pulls/2618","html_url":"https://github.com/tj/commander.js/pull/2618","diff_url":"https://github.com/tj/commander.js/pull/2618.diff","patch_url":"https://github.com/tj/commander.js/pull/2618.patch","merged_at":null},"body":"## Problem\r\n\r\nRefs #2614. Option placeholders such as `--tag <值...>` currently fail to enable variadic parsing because `\\w` matches only ASCII characters. The same syntax works for ASCII placeholder names.\r\n\r\n## Solution\r\n\r\nRecognize Unicode letters and numbers before the `...` suffix while retaining the existing underscore behavior. Add required and optional option regression cases. The existing test rejecting custom separators such as `[value,...]` remains passing.\r\n\r\n## Validation\r\n\r\n- New required-option regression failed on the unmodified `develop` branch with `too many arguments`; both new cases pass with the change.\r\n- `node --test`: 1,406 passing, 4 skipped (after clearing the host’s `NO_COLOR=1` so the color-environment tests can run).\r\n- ESLint, Prettier, JS and TS type checks, and tsd: passed.\r\n- `git diff --check`: passed.\r\n\r\n## ChangeLog\r\n\r\n- Fix variadic options with Unicode placeholder names.","reactions":{"url":"https://api.github.com/repos/tj/commander.js/issues/2618/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"timeline_url":"https://api.github.com/repos/tj/commander.js/issues/2618/timeline","performed_via_github_app":null,"state_reason":null}},"event":"cross-referenced"},{"id":31962393884,"node_id":"REFE_lADOACGs6c8AAAABSE5Tms8AAAAHcRttHA","url":"https://api.github.com/repos/tj/commander.js/issues/events/31962393884","actor":{"login":"abetomo","id":846454,"node_id":"MDQ6VXNlcjg0NjQ1NA==","avatar_url":"https://avatars.githubusercontent.com/u/846454?v=4","gravatar_id":"","url":"https://api.github.com/users/abetomo","html_url":"https://github.com/abetomo","followers_url":"https://api.github.com/users/abetomo/followers","following_url":"https://api.github.com/users/abetomo/following{/other_user}","gists_url":"https://api.github.com/users/abetomo/gists{/gist_id}","starred_url":"https://api.github.com/users/abetomo/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/abetomo/subscriptions","organizations_url":"https://api.github.com/users/abetomo/orgs","repos_url":"https://api.github.com/users/abetomo/repos","events_url":"https://api.github.com/users/abetomo/events{/privacy}","received_events_url":"https://api.github.com/users/abetomo/received_events","type":"User","user_view_type":"public","site_admin":false},"event":"referenced","commit_id":"a9f06ddfe1a97c932579370a1b4e727f7fa511a7","commit_url":"https://api.github.com/repos/tj/commander.js/commits/a9f06ddfe1a97c932579370a1b4e727f7fa511a7","created_at":"2026-09-28T04:11:11Z","performed_via_github_app":null},{"actor":{"login"