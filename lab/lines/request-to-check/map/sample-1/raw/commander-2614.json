    "createdAt": "2026-09-19T05:36:50Z",
    "mergedAt": "2026-09-28T04:11:09Z",
    "merged": true
  },
  "files": [
    {
      "sha": "ff8886ad95b89552b0787e2830c666b69ac88d12",
      "filename": "lib/option.js",
      "status": "modified",
      "additions": 1,
      "deletions": 1,
      "changes": 2,
      "blob_url": "https://github.com/tj/commander.js/blob/f168aaa5e1e0e20982099d1a08e3f018656d774d/lib%2Foption.js",
      "raw_url": "https://github.com/tj/commander.js/raw/f168aaa5e1e0e20982099d1a08e3f018656d774d/lib%2Foption.js",
      "contents_url": "https://api.github.com/repos/tj/commander.js/contents/lib%2Foption.js?ref=f168aaa5e1e0e20982099d1a08e3f018656d774d",
      "patch": "@@ -15,7 +15,7 @@ export class Option {\n     this.required = flags.includes('<'); // A value must be supplied when the option is specified.\n     this.optional = flags.includes('['); // A value is optional when the option is specified.\n     // variadic test ignores <value,...> et al which might be used to describe custom splitting of single argument\n-    this.variadic = /\\w\\.\\.\\.[>\\]]$/.test(flags); // The option can take multiple values.\n+    this.variadic = /\\p{ID_Continue}\\.\\.\\.[>\\]]$/u.test(flags); // The option can take multiple values.\n     this.mandatory = false; // The option must have a value after parsing, which usually means it must be specified on command line.\n     const optionFlags = splitOptionFlags(flags);\n     this.short = optionFlags.shortFlag; // May be a short flag, undefined, or even a long flag (if option has two long flags)."
    },
    {
      "sha": "ff3087228892ea8b1efab1717b93c98210eeef9a",
      "filename": "tests/options.variadic.test.js",
      "status": "modified",
      "additions": 7,
      "deletions": 0,
      "changes": 7,
      "blob_url": "https://github.com/tj/commander.js/blob/f168aaa5e1e0e20982099d1a08e3f018656d774d/tests%2Foptions.variadic.test.js",
      "raw_url": "https://github.com/tj/commander.js/raw/f168aaa5e1e0e20982099d1a08e3f018656d774d/tests%2Foptions.variadic.test.js",
      "contents_url": "https://api.github.com/repos/tj/commander.js/contents/tests%2Foptions.variadic.test.js?ref=f168aaa5e1e0e20982099d1a08e3f018656d774d",
      "patch": "@@ -169,6 +169,13 @@ describe('variadic options', () => {\n       assert.equal(program.options[0].variadic, true);\n     });\n \n+    test('when option flags has non-ASCII character before dots then is variadic', () => {\n+      const program = new commander.Command();\n+      program.option('-c,--comma [cafe\\u0301...]');\n+\n+      assert.equal(program.options[0].variadic, true);\n+    });\n+\n     test('when option flags has special characters before dots then not variadic', () => {\n       // This might be used to describe coercion for comma separated values, and is not variadic.\n       const program = new commander.Command();"
    }
