    "title": "Fix `json!` invocations when std prelude is not in scope",
    "createdAt": "2024-08-01T21:23:03Z",
    "mergedAt": "2024-08-01T21:26:50Z"
  },
  "files": [
    {
      "sha": "4ef91095fa313fb4115c45a37136e517eca26fa9",
      "filename": "src/lib.rs",
      "status": "modified",
      "additions": 6,
      "deletions": 0,
      "changes": 6,
      "blob_url": "https://github.com/serde-rs/json/blob/6827c7b3c582a8fe30beb8ddb9e2446bfc391ea7/src%2Flib.rs",
      "raw_url": "https://github.com/serde-rs/json/raw/6827c7b3c582a8fe30beb8ddb9e2446bfc391ea7/src%2Flib.rs",
      "contents_url": "https://api.github.com/repos/serde-rs/json/contents/src%2Flib.rs?ref=6827c7b3c582a8fe30beb8ddb9e2446bfc391ea7",
      "patch": "@@ -373,6 +373,12 @@ extern crate alloc;\n #[cfg(feature = \"std\")]\n extern crate std;\n \n+// Not public API. Used from macro-generated code.\n+#[doc(hidden)]\n+pub mod __private {\n+    pub use alloc::vec;\n+}\n+\n #[cfg(feature = \"std\")]\n #[cfg_attr(docsrs, doc(cfg(feature = \"std\")))]\n #[doc(inline)]"
    },
    {
      "sha": "c47bdf9298c255c93f69f81e04b6a68ae6ccfbfa",
      "filename": "src/macros.rs",
      "status": "modified",
      "additions": 3,
      "deletions": 3,
      "changes": 6,
      "blob_url": "https://github.com/serde-rs/json/blob/6827c7b3c582a8fe30beb8ddb9e2446bfc391ea7/src%2Fmacros.rs",
      "raw_url": "https://github.com/serde-rs/json/raw/6827c7b3c582a8fe30beb8ddb9e2446bfc391ea7/src%2Fmacros.rs",
      "contents_url": "https://api.github.com/repos/serde-rs/json/contents/src%2Fmacros.rs?ref=6827c7b3c582a8fe30beb8ddb9e2446bfc391ea7",
      "patch": "@@ -77,12 +77,12 @@ macro_rules! json_internal {\n \n     // Done with trailing comma.\n     (@array [$($elems:expr,)*]) => {\n-        vec![$($elems,)*]\n+        $crate::__private::vec![$($elems,)*]\n     };\n \n     // Done without trailing comma.\n     (@array [$($elems:expr),*]) => {\n-        vec![$($elems),*]\n+        $crate::__private::vec![$($elems),*]\n     };\n \n     // Next element is `null`.\n@@ -254,7 +254,7 @@ macro_rules! json_internal {\n     };\n \n     ([]) => {\n-        $crate::Value::Array(vec![])\n+        $crate::Value::Array($crate::__private::vec![])\n     };\n \n     ([ $($tt:tt)+ ]) => {"
