{
  "schemaVersion": 1,
  "box": {
    "id": "a4-py-tools-slugify",
    "name": "Implement real slugify in the a4-py-tools slug helper",
    "version": 1
  },
  "outcome": "In tools/slug.py make slugify(text) produce URL slugs: lowercase ASCII, every run of characters outside [a-z0-9] becomes a single hyphen, leading and trailing hyphens stripped, empty or non-string input maps to ''. Edit only the declared editable file.",
  "sourceRoot": "examples/a4-py-tools",
  "files": [
    {
      "owner": "pyproject.toml",
      "box": "pyproject.toml"
    },
    {
      "owner": "README.md",
      "box": "README.md"
    },
    {
      "owner": "checks/guard.py",
      "box": "checks/guard.py"
    },
    {
      "owner": "checks/outcome.py",
      "box": "checks/outcome.py"
    }
  ],
  "entrypoints": [
    "tools/slug.py"
  ],
  "editable": [
    {
      "kind": "copy",
      "owner": "tools/slug.py",
      "box": "tools/slug.py"
    }
  ],
  "readContext": [],
  "declaredDependencies": {},
  "excludedPrefixes": [
    "box-agreements/",
    "__pycache__/",
    ".git/"
  ],
  "inventoryExcludePrefixes": [
    "box-agreements/",
    "__pycache__/",
    ".git/"
  ],
  "requires": [
    {
      "program": "python"
    },
    {
      "program": "node",
      "version": ">=24.11.0 <25"
    }
  ],
  "checks": [
    "declared outcome: python checks/outcome.py rejects unslugged text; declared guard: python checks/guard.py keeps str/empty-input behavior green"
  ],
  "evaluator": [],
  "setup": [],
  "commands": [
    {
      "name": "slug-guard",
      "program": "python",
      "args": [
        "checks/guard.py"
      ],
      "cwd": "examples/a4-py-tools",
      "context": "owner",
      "role": "guard",
      "timeoutMs": 120000
    },
    {
      "name": "slug-outcome",
      "program": "python",
      "args": [
        "checks/outcome.py"
      ],
      "cwd": "examples/a4-py-tools",
      "context": "owner",
      "role": "outcome",
      "timeoutMs": 120000
    },
    {
      "name": "box-slug-guard",
      "program": "python",
      "args": [
        "checks/guard.py"
      ],
      "cwd": ".",
      "context": "recipient",
      "role": "guard",
      "timeoutMs": 120000
    },
    {
      "name": "box-slug-outcome",
      "program": "python",
      "args": [
        "checks/outcome.py"
      ],
      "cwd": ".",
      "context": "recipient",
      "role": "outcome",
      "timeoutMs": 120000
    }
  ],
  "submission": {
    "format": "editable-overlay",
    "instructions": "Edit only the file listed in box.json editable paths (tools/slug.py). It maps back to tools/slug.py in the owner repository. Make slugify(text) return lowercase ASCII slugs: runs of non-[a-z0-9] characters collapse to single hyphens, edge hyphens are stripped, empty or non-string input returns ''. Seal the work with node box/submit.mjs and return submission.json."
  }
}
