#!/bin/sh
# K31 box wrapper for machine A agents. Bakes the scratch settings dir so the
# owner's real settings are never read or written, puts the logging gh on
# PATH for the tool's own gh calls, then runs the scratch-installed box.
export BOX_BOUNTY_SETTINGS_DIR="C:/Users/shout/AppData/Local/Temp/box-k31/settings-a"
export PATH="/c/Users/shout/AppData/Local/Temp/box-k31/shim-a:$PATH"
exec "/c/Users/shout/AppData/Local/Temp/box-k31/prefix/node_modules/box-bounty/dist/box.js" "$@"
