+      const child = mockChild();
+      calls += 1;
+      setTimeout(() => { child.stdout.write('captured-before-exit'); child.emit('exit', 0, null); }, 5);
+      // Neither stream ends and no close arrives: the actual drain timer must fire.
+      return child;
+    } });
