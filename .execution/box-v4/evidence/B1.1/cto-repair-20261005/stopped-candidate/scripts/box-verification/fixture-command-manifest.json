  "schemaVersion": 1,
  "purpose": "Complete allowlist for the W002/B1.1 verification fixture transport. Every entry is a fixed argument-array 'docker exec' into one of two W002-owned synthetic service containers; env, workdir, argv and container come only from this manifest, never from client strings. -e entries bind an exact sha256 of the expanded literal source.",
  "containers": {
    "private-api": "w002-b11-svc-private-api",
    "external-api": "w002-b11-svc-external-api"
  },
  "notes": {
    "destructiveAudit": "No DROP/TRUNCATE/database-reset commands exist in any reached script. empty-migrations sources run CREATE DATABASE synthetic_empty_<32-hex> (creation on the owned synthetic postgres; names are randomUUID-derived hex, never client SQL). readiness/private source contains DELETE/UPDATE statements only inside assert.rejects denial probes that the immutable-readiness triggers must reject. All other sources are INSERT/SELECT/transaction probes on synthetic fixture databases.",
    "contractBinding": "persistence/lifecycles sources embed JSON.stringify(singleUnitContract()); digests computed for contract sha256 bcb46146f2b32049c471fa92fb74a7e9d9ba42a704e916993aba529db66eb4b2. A changed fixture contract produces a new digest and therefore denies transport.",
    "doctorEntries": "Reached by scripts/verify-mvp.mjs only when a local docker binary probe passes; unreachable inside the isolated workspace but listed for completeness."
  },
