{
  "compilerOptions": {
    "target": "ES2023",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "verbatimModuleSyntax": true,
    "jsx": "react-jsx",
    "esModuleInterop": true,
    "skipLibCheck": true,
    "rootDir": ".",
    "outDir": ".runtime/build",
    "sourceMap": false,
    "declaration": true,
    "types": ["node", "react", "react-dom"]
  },
  "include": ["apps/**/*.ts", "apps/**/*.tsx", "services/**/*.ts", "packages/**/*.ts", "examples/**/*.ts", "examples/**/*.tsx", "tests/**/*.ts"],
  "exclude": ["node_modules", "**/dist", ".runtime", "templates/workspaces"]
}
